# Copy this file to .env before running Docker Compose and change every secret.
PULSEFIT_DB_NAME=pulsefit_gym
PULSEFIT_DB_USER=pulsefit
PULSEFIT_DB_PASSWORD=change-this-database-password
PULSEFIT_DB_ROOT_PASSWORD=change-this-root-password

GYM_ENV=development
GYM_ADMIN_USERNAME=admin
GYM_ADMIN_PASSWORD=change-this-admin-password
GYM_SECURE_COOKIES=0
GYM_ALLOWED_HOSTS=localhost,127.0.0.1
GYM_ALLOWED_ORIGINS=http://localhost:3333,http://127.0.0.1:3333
GYM_TRUST_PROXY_HEADERS=0
GYM_METRICS_TOKEN=replace-with-at-least-32-random-characters
GYM_DAH_AGENT_TOKEN=replace-with-at-least-24-random-characters
GYM_LOG_LEVEL=INFO
