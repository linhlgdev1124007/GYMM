GYM_ENV=development
GYM_ADMIN_USERNAME=admin
GYM_ADMIN_PASSWORD=change-this-password
GYM_SECURE_COOKIES=0
GYM_ALLOWED_HOSTS=127.0.0.1,localhost
GYM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8100
GYM_TRUST_PROXY_HEADERS=0
GYM_LOGIN_RATE_LIMIT=10
GYM_LOGIN_RATE_WINDOW_SECONDS=900
GYM_API_RATE_LIMIT=600
GYM_API_RATE_WINDOW_SECONDS=60
GYM_MAX_REQUEST_BYTES=57671680
GYM_SESSION_DAYS=7
GYM_MAX_SESSIONS_PER_USER=5
GYM_ENABLE_API_DOCS=0
GYM_METRICS_TOKEN=replace-with-at-least-32-random-characters
GYM_DAH_AGENT_TOKEN=replace-with-at-least-24-random-characters
GYM_DAH_AGENT_LATEST_VERSION=
GYM_DAH_AGENT_DOWNLOAD_URL=
GYM_DAH_AGENT_SHA256=
GYM_DAH_AGENT_MANDATORY_UPDATE=0
GYM_LOG_LEVEL=INFO
GYM_DB_HOST=127.0.0.1
GYM_DB_PORT=3306
GYM_DB_USER=root
GYM_DB_PASSWORD=
GYM_DB_NAME=pulsefit_gym
# GYM_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/pulsefit_gym?charset=utf8mb4
# OTEL_SERVICE_NAME=pulsefit-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
# Test-only SQLite fallback:
# GYM_DATABASE_PATH=D:\path\to\test.sqlite3
